# -----------------------------------------------------------------------------
# Lendermarket Investor Relations AI Copilot - environment template
# Copy the variables you need into Railway (Service -> Variables).
# Never commit real values. `.env` files are git-ignored.
# -----------------------------------------------------------------------------

# --- Database (Railway PostgreSQL) -------------------------------------------
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Public URL ---------------------------------------------------------------
# The public Railway URL of this service, e.g. https://chatbot-app-production.up.railway.app
APP_URL="https://your-service.up.railway.app"

# --- AI providers (server-side only, never exposed to the browser) ------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Default provider/model used until an administrator activates a model in /admin/ai-settings.
# AI_PROVIDER: "anthropic" | "openai"
AI_PROVIDER="anthropic"
AI_MODEL="claude-opus-5-5"

# Embeddings for semantic search. EMBEDDING_PROVIDER: "openai" | "none"
# With "none", retrieval falls back to PostgreSQL full-text search only.
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Admin authentication -----------------------------------------------------
# Long random string (>= 32 chars). Used to sign admin session cookies and as the
# one-time setup token at /admin/setup (only works while no admin user exists).
# Generate with: openssl rand -base64 48
ADMIN_AUTH_SECRET=""

# --- Document storage ---------------------------------------------------------
# DOCUMENT_STORAGE: "database" (default; files stored privately in PostgreSQL)
#                 | "s3" (any S3-compatible bucket, e.g. Railway Buckets, AWS S3, Cloudflare R2)
DOCUMENT_STORAGE="database"
DOCUMENT_STORAGE_BUCKET=""
DOCUMENT_STORAGE_REGION="auto"
DOCUMENT_STORAGE_ENDPOINT=""
DOCUMENT_STORAGE_ACCESS_KEY_ID=""
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=""
# Maximum upload size in megabytes
DOCUMENT_MAX_UPLOAD_MB="20"

# --- Widget embedding ---------------------------------------------------------
# Space-separated list of origins allowed to embed the chat widget iframe.
# Example: "https://www.lendermarket.com https://lendermarket.com"
WIDGET_ALLOWED_ORIGINS=""

# --- Website ingestion --------------------------------------------------------
# Space-separated hostnames that may be imported as public website sources.
WEBSITE_ALLOWED_HOSTS="www.lendermarket.com lendermarket.com"

# --- Abuse protection ---------------------------------------------------------
CHAT_RATE_LIMIT_PER_MINUTE="12"
CHAT_RATE_LIMIT_PER_DAY="300"
